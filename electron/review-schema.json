{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message": { "type": "string" },
          "hint": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 0 },
          "line_end": { "type": "integer", "minimum": 0 },
          "code_excerpt": { "type": "string" }
        },
        "required": ["message", "hint", "line_start", "line_end", "code_excerpt"]
      }
    }
  },
  "required": ["verdict", "summary", "issues"]
}
