{
  "kind": "html",
  "caption": "先遍历示例数组，用哈希表统计每个元素的出现次数：1 出现 3 次，2 出现 2 次，3 出现 1 次。再把元素放入“频率桶”，从最高频率向下扫描，依次取出 1 和 2，凑满 k = 2 后结束。桶的数量至多为 n + 1，因此统计和扫描都只需 O(n) 时间，优于排序所需的 O(n log n)。",
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>前 K 个高频元素可视化</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:auto;background:#1c1c1c;color:#d4d4d4;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif;font-size:12px;line-height:1.45}\nmain{max-width:560px;margin:0 auto;padding:8px 10px 10px}\nh1{margin:0 0 4px;font-size:14px;font-weight:600;color:#d4d4d4}\n.lead{margin:0 0 8px;color:#8d8d8d;font-size:12px;line-height:1.45}\n.panel{margin-top:8px;padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#252526}\n.panel-title{margin:0 0 6px;font-size:13px;font-weight:600;color:#d4d4d4}\n.rule{padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45}\n.mono{font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.accent{color:#3794ff;font-weight:600}\n.muted{color:#8d8d8d}\n.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n@media(max-width:520px){.grid2{grid-template-columns:1fr}}\n.array,.chars,.row-wrap{display:flex;flex-wrap:wrap;gap:6px}\n.cell,.char,.num-cell{width:38px;min-height:48px;padding:4px 2px;border:1px solid #3c3c3c;border-radius:4px;background:#2d2d30;display:flex;flex-direction:column;align-items:center;justify-content:center;font:600 14px \"SF Mono\",Monaco,Menlo,monospace;transition:.3s}\n.cell .idx,.char .index,.index,.marker{font-size:10px;color:#8d8d8d;margin-top:2px;font-weight:400}\n.cell.active,.cell.mid,.cell.current,.cell.found,.cell.max,.char.active,.num-cell.active{background:#0e639c;border-color:#3794ff;color:#fff}\n.cell.out,.cell.discarded{opacity:.35}\n.card{padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#2d2d30}\n.card-label{font-size:10px;color:#8d8d8d;margin-bottom:4px}\n.card-value{font-size:13px;font-weight:600;font-family:\"SF Mono\",Monaco,Menlo,monospace;color:#3794ff}\n.progress{display:flex;gap:4px;margin-top:8px}\n.dot,.pill{flex:1;height:3px;border-radius:2px;background:#3c3c3c;transition:background .3s}\n.dot.on,.pill.on{background:#3794ff}\n.pills{display:flex;flex-wrap:wrap;gap:4px}\n.pills .pill{flex:none;height:auto;padding:2px 7px;border-radius:4px;font-size:10px;border:1px solid #3c3c3c;color:#8d8d8d}\n.pills .pill.active,.pills .pill.on{background:#0e639c;border-color:#3794ff;color:#fff}\n.status{margin-top:6px;padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45;min-height:auto}\n\n.row .cell{min-width:38px;width:38px}\n.index,.tag{font-size:10px;color:#8d8d8d;display:block;margin-top:2px}\n.counter{min-width:72px;padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#2d2d30}\n.counter.active{background:#0e639c;border-color:#3794ff}\n.counter-line{display:flex;justify-content:space-between;gap:8px;font-size:12px}\n.count{font-family:\"SF Mono\",Monaco,Menlo,monospace;font-size:13px;color:#3794ff;font-weight:700}\n.bucket-list{display:flex;flex-direction:column;gap:4px}\n.bucket{display:grid;grid-template-columns:72px 1fr;gap:6px;padding:6px 8px;border:1px solid #3c3c3c;border-radius:6px;background:#2d2d30;font-size:11px}\n.bucket.active{background:#0e639c;border-color:#3794ff}\n.bucket-items{display:flex;flex-wrap:wrap;gap:4px;align-items:center}\n.token{padding:2px 7px;border:1px solid #3794ff;border-radius:4px;font-size:11px;font-family:\"SF Mono\",Monaco,Menlo,monospace;background:#153b55}\n.empty{color:#8d8d8d;font-size:11px}\n.result{display:flex;gap:6px;margin-top:6px}\n.result-cell{min-width:38px;padding:8px 10px;border:1px dashed #3c3c3c;border-radius:6px;text-align:center;font-size:12px}\n.result-cell.filled{background:#0e639c;border:1px solid #3794ff;color:#fff}\n.result-num{font-family:\"SF Mono\",Monaco,Menlo,monospace;font-size:13px;font-weight:700}\n.complexity{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}\n.complexity .pill{flex:none;height:auto;padding:2px 7px;border-radius:4px;font-size:10px;border:1px solid #3c3c3c;color:#8d8d8d}\n\n.counter.active .count,.counter.active .tag,.bucket.active .tag{color:#fff}\n</style>\n</head>\n<body>\n<main>\n<h1>频率桶取 Top K</h1>\n<p class=\"lead\"><span class=\"mono\">nums = [1,1,1,2,2,3]</span> · <span class=\"mono\">k = 2</span></p>\n<section class=\"panel\"><div class=\"panel-title\">① 统计频率</div><div class=\"row\" id=\"array\"></div></section>\n<section class=\"panel\"><div class=\"panel-title\">频率表</div><div class=\"row\" id=\"counters\"></div></section>\n<section class=\"panel\"><div class=\"panel-title\">② 入桶</div><div class=\"bucket-list\" id=\"buckets\"></div></section>\n<section class=\"panel\"><div class=\"panel-title\">③ 倒序收集</div><div class=\"result\" id=\"result\"></div></section>\n<div class=\"status\" id=\"status\"><strong>准备：</strong>先统计出现次数。</div>\n<div class=\"complexity\"><div class=\"pill\">统计 O(n)</div><div class=\"pill\">扫描 O(n)</div></div>\n</main>\n<script>\n\n(() => {\n  const nums = [1, 1, 1, 2, 2, 3];\n  const values = [1, 2, 3];\n\n  const arrayEl = document.getElementById('array');\n  const countersEl = document.getElementById('counters');\n  const bucketsEl = document.getElementById('buckets');\n  const resultEl = document.getElementById('result');\n  const statusEl = document.getElementById('status');\n\n  arrayEl.innerHTML = nums.map((n, i) => `<div class=\"cell\" id=\"a${i}\"><span class=\"num\">${n}</span><span class=\"index\">下标 ${i}</span></div>`).join('');\n  countersEl.innerHTML = values.map(v => `<div class=\"counter\" id=\"c${v}\"><div class=\"counter-line\"><span class=\"counter-label\">元素 <span class=\"mono\">${v}</span></span><span class=\"count\" id=\"count${v}\">0</span></div><span class=\"tag\">出现次数</span></div>`).join('');\n  bucketsEl.innerHTML = [6,5,4,3,2,1].map(f => `<div class=\"bucket\" id=\"b${f}\"><div class=\"bucket-key\"><span class=\"bucket-id\">频率 ${f}</span><span class=\"tag\">出现 ${f} 次</span></div><div class=\"bucket-items\" id=\"items${f}\"><span class=\"empty\">空</span></div></div>`).join('');\n  resultEl.innerHTML = `<div class=\"result-cell\" id=\"r0\"><span class=\"result-num\">?</span><span class=\"tag\">第 1 个</span></div><div class=\"result-cell\" id=\"r1\"><span class=\"result-num\">?</span><span class=\"tag\">第 2 个</span></div>`;\n\n  const pause = ms => new Promise(resolve => setTimeout(resolve, ms));\n  const clearHighlights = () => document.querySelectorAll('.active').forEach(el => el.classList.remove('active'));\n  const reset = () => {\n    clearHighlights();\n    values.forEach(v => document.getElementById(`count${v}`).textContent = '0');\n    for (let f = 1; f <= 6; f++) document.getElementById(`items${f}`).innerHTML = '<span class=\"empty\">空</span>';\n    for (let i = 0; i < 2; i++) {\n      const cell = document.getElementById(`r${i}`);\n      cell.classList.remove('filled');\n      cell.querySelector('.result-num').textContent = '?';\n    }\n    statusEl.innerHTML = '<strong>准备开始：</strong>先统计每个数字出现了几次。';\n  };\n\n  async function play() {\n    reset();\n    await pause(1800);\n    const counts = {1: 0, 2: 0, 3: 0};\n    const buckets = Array.from({length: nums.length + 1}, () => []);\n    for (let i = 0; i < nums.length; i++) {\n      clearHighlights();\n      const v = nums[i];\n      counts[v]++;\n      document.getElementById(`a${i}`).classList.add('active');\n      document.getElementById(`c${v}`).classList.add('active');\n      document.getElementById(`count${v}`).textContent = counts[v];\n      statusEl.innerHTML = `<strong>统计：</strong>读到下标 <span class=\"mono\">${i}</span> 的数字 <span class=\"mono\">${v}</span>，它的频率增加到 <span class=\"mono\">${counts[v]}</span>。`;\n      await pause(1600);\n    }\n\n    clearHighlights();\n    statusEl.innerHTML = '<strong>统计完成：</strong>频率表为 <span class=\"mono\">{1:3, 2:2, 3:1}</span>。接着让“频率”直接充当桶下标。';\n    await pause(2200);\n\n    for (const v of values) {\n      clearHighlights();\n      const f = counts[v];\n      buckets[f].push(v);\n      document.getElementById(`c${v}`).classList.add('active');\n      document.getElementById(`b${f}`).classList.add('active');\n      const holder = document.getElementById(`items${f}`);\n      holder.innerHTML = buckets[f].map(value => `<span class=\"token\">${value}</span>`).join('');\n      statusEl.innerHTML = `<strong>放入桶：</strong>元素 <span class=\"mono\">${v}</span> 出现 <span class=\"mono\">${f}</span> 次，进入“频率 ${f}”桶。`;\n      await pause(1800);\n    }\n\n    clearHighlights();\n    statusEl.innerHTML = '<strong>倒序扫描：</strong>从最高可能频率 <span class=\"mono\">6</span> 开始，空桶直接跳过。';\n    await pause(1800);\n\n    let resultIndex = 0;\n    for (let f = 6; f >= 1; f--) {\n      clearHighlights();\n      document.getElementById(`b${f}`).classList.add('active');\n      const found = buckets[f];\n      if (found.length === 0) {\n        statusEl.innerHTML = `<strong>检查频率 ${f}：</strong>桶为空，继续向低频移动。`;\n        await pause(1500);\n      } else {\n        for (const v of found) {\n          const slot = document.getElementById(`r${resultIndex}`);\n          slot.classList.add('filled');\n          slot.querySelector('.result-num').textContent = v;\n          resultIndex++;\n          statusEl.innerHTML = `<strong>命中频率 ${f}：</strong>取出元素 <span class=\"mono\">${v}</span>，答案已有 <span class=\"mono\">${resultIndex}/2</span> 个。`;\n          await pause(1900);\n          if (resultIndex === 2) break;\n        }\n      }\n      if (resultIndex === 2) break;\n    }\n\n    clearHighlights();\n    document.getElementById('r0').classList.add('filled');\n    document.getElementById('r1').classList.add('filled');\n    statusEl.innerHTML = '<strong>完成：</strong>已取得 <span class=\"mono\">k = 2</span> 个元素，结果为 <span class=\"mono\">[1, 2]</span>。无需给所有元素排序。';\n    await pause(3500);\n  }\n\n  async function loop() {\n    while (true) await play();\n  }\n  loop();\n})();\n\n</script>\n</body>\n</html>",
  "svg": "",
  "media": ""
}
