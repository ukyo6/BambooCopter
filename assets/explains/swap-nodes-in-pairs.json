{"kind":"html","caption":"用虚拟头节点统一处理头节点变化，每次取出相邻的 first 和 second，并只调整三个 next 指针完成交换。动画用示例 [1,2,3,4] 展示两轮局部交换；每轮结束后 prev 前进到已交换节点对的末尾，剩余不足两个节点时直接停止。","html":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>两两交换链表节点</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:auto;background:#1c1c1c;color:#d4d4d4;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif;font-size:12px;line-height:1.45}\nmain{max-width:560px;margin:0 auto;padding:8px 10px 10px}\nh1{margin:0 0 4px;font-size:14px;font-weight:600;color:#d4d4d4}\n.lead{margin:0 0 8px;color:#8d8d8d;font-size:12px;line-height:1.45}\n.panel{margin-top:8px;padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#252526}\n.panel-title{margin:0 0 6px;font-size:13px;font-weight:600;color:#d4d4d4}\n.rule{padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45}\n.mono{font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.accent{color:#3794ff;font-weight:600}\n.muted{color:#8d8d8d}\n.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n@media(max-width:520px){.grid2{grid-template-columns:1fr}}\n.array,.chars,.row-wrap{display:flex;flex-wrap:wrap;gap:6px}\n.cell,.char,.num-cell{width:38px;min-height:48px;padding:4px 2px;border:1px solid #3c3c3c;border-radius:4px;background:#2d2d30;display:flex;flex-direction:column;align-items:center;justify-content:center;font:600 14px \"SF Mono\",Monaco,Menlo,monospace;transition:.3s}\n.cell .idx,.char .index,.index,.marker{font-size:10px;color:#8d8d8d;margin-top:2px;font-weight:400}\n.cell.active,.cell.mid,.cell.current,.cell.found,.cell.max,.char.active,.num-cell.active{background:#0e639c;border-color:#3794ff;color:#fff}\n.cell.out,.cell.discarded{opacity:.35}\n.card{padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#2d2d30}\n.card-label{font-size:10px;color:#8d8d8d;margin-bottom:4px}\n.card-value{font-size:13px;font-weight:600;font-family:\"SF Mono\",Monaco,Menlo,monospace;color:#3794ff}\n.progress{display:flex;gap:4px;margin-top:8px}\n.dot,.pill{flex:1;height:3px;border-radius:2px;background:#3c3c3c;transition:background .3s}\n.dot.on,.pill.on{background:#3794ff}\n.pills{display:flex;flex-wrap:wrap;gap:4px}\n.pills .pill{flex:none;height:auto;padding:2px 7px;border-radius:4px;font-size:10px;border:1px solid #3c3c3c;color:#8d8d8d}\n.pills .pill.active,.pills .pill.on{background:#0e639c;border-color:#3794ff;color:#fff}\n.status{margin-top:6px;padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45;min-height:auto}\n\n.subtitle{color:#8d8d8d;font-size:12px;line-height:1.45;margin:0}\n.chain{display:flex;flex-wrap:wrap;gap:4px;align-items:center;margin-top:6px}\n.node{min-width:38px;width:38px;min-height:48px;padding:4px 2px;border:1px solid #3c3c3c;border-radius:4px;background:#2d2d30;text-align:center}\n.node.active{background:#0e639c;border-color:#3794ff;color:#fff}\n.value{font-size:14px;font-weight:700;font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.role{font-size:10px;color:#3794ff;margin-top:2px}\n.node-wrap{display:flex;align-items:center;gap:4px}\n.arrow{color:#8d8d8d;font-size:12px;font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.null{font-size:11px;color:#8d8d8d}\n.links{display:grid;grid-template-columns:1fr;gap:4px;margin-top:6px}\n.link{padding:6px 8px;border:1px solid #3c3c3c;border-radius:4px;font-size:11px;line-height:1.45;background:#2d2d30}\n.link.on{background:#0e639c;border-color:#3794ff;color:#fff}\n.progress .dot{flex:none;height:auto;padding:2px 7px;border-radius:4px;font-size:10px;border:1px solid #3c3c3c;color:#8d8d8d}\n.progress .dot.on{background:#0e639c;border-color:#3794ff;color:#fff}\n.note{font-size:11px;color:#8d8d8d;line-height:1.45;margin-top:6px}\n\n</style>\n</head>\n<body>\n<main>\n<h1>两两交换相邻节点</h1>\n<p class=\"subtitle\">示例 <span class=\"mono\">[1,2,3,4]</span>，虚拟头 <code class=\"mono\">dummy</code>。</p>\n<div id=\"status\" class=\"status\"></div>\n<div id=\"chain\" class=\"chain\"></div>\n<div id=\"links\" class=\"links\"></div>\n<div id=\"progress\" class=\"progress\"></div>\n<div class=\"note panel\" style=\"margin-top:8px\">需 <code class=\"mono\">prev.next</code> 与 <code class=\"mono\">prev.next.next</code> 均存在 · O(n) 时间 O(1) 空间</div>\n</main>\n<script>\n\nconst steps = [\n  {\n    text: '准备：dummy 指向头节点，prev 从 dummy 开始。',\n    order: ['D','1','2','3','4'], roles: {D:'prev'}, active:['D'],\n    links: ['等待处理第一对节点 1、2'], linkOn: 0\n  },\n  {\n    text: '第一轮：确定 first = 1，second = 2。',\n    order: ['D','1','2','3','4'], roles: {D:'prev','1':'first','2':'second'}, active:['1','2'],\n    links: ['first.next 指向 second.next，也就是节点 3','second.next 指向 first','prev.next 指向 second'], linkOn: 0\n  },\n  {\n    text: '依次改写三个 next 指针，第一对交换完成。',\n    order: ['D','2','1','3','4'], roles: {'1':'prev'}, active:['2','1'],\n    links: ['1.next → 3','2.next → 1','dummy.next → 2'], linkOn: 2\n  },\n  {\n    text: 'prev 移到节点 1，下一对是节点 3、4。',\n    order: ['D','2','1','3','4'], roles: {'1':'prev','3':'first','4':'second'}, active:['3','4'],\n    links: ['确定下一组 first = 3','确定下一组 second = 4'], linkOn: 1\n  },\n  {\n    text: '第二轮：用同样的三次连接完成局部交换。',\n    order: ['D','2','1','4','3'], roles: {'3':'prev'}, active:['4','3'],\n    links: ['3.next → null','4.next → 3','1.next → 4'], linkOn: 2\n  },\n  {\n    text: '结束：后面不足两个节点，返回 dummy.next，结果为 [2,1,4,3]。',\n    order: ['D','2','1','4','3'], roles: {}, active:['2','1','4','3'],\n    links: ['返回头节点 2','最终链表：2 → 1 → 4 → 3'], linkOn: 1\n  }\n];\nconst labels = {D:'dummy','1':'1','2':'2','3':'3','4':'4'};\nlet current = 0;\nfunction render() {\n  const s = steps[current];\n  document.getElementById('status').textContent = s.text;\n  const chain = document.getElementById('chain');\n  chain.innerHTML = '';\n  s.order.forEach((id, i) => {\n    const wrap = document.createElement('div');\n    wrap.className = 'node-wrap';\n    const node = document.createElement('div');\n    node.className = 'node' + (s.active.includes(id) ? ' active' : '');\n    node.innerHTML = '<div class=\"value\">' + labels[id] + '</div><div class=\"role\">' + (s.roles[id] || '节点') + '</div>';\n    wrap.appendChild(node);\n    if (i < s.order.length - 1) {\n      const arrow = document.createElement('span');\n      arrow.className = 'arrow'; arrow.textContent = '→'; wrap.appendChild(arrow);\n    }\n    chain.appendChild(wrap);\n  });\n  const nil = document.createElement('span'); nil.className = 'null'; nil.textContent = '→ null'; chain.appendChild(nil);\n  const links = document.getElementById('links');\n  links.innerHTML = s.links.map((x,i) => '<div class=\"link' + (i === s.linkOn ? ' on' : '') + '\">' + x + '</div>').join('');\n  document.getElementById('progress').innerHTML = steps.map((_,i) => '<span class=\"dot' + (i === current ? ' on' : '') + '\">步骤 ' + (i+1) + '</span>').join('');\n}\nrender();\nsetInterval(() => { current = (current + 1) % steps.length; render(); }, 2000);\n\n</script>\n</body>\n</html>","svg":"","media":""}
