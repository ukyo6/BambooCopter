{
  "kind": "html",
  "caption": "从根节点的左右子树开始，每次成对比较镜像位置：数值必须相同，并继续比较“左的左与右的右”“左的右与右的左”。动画先展示示例 1 的所有镜像对均匹配，因此返回 true；随后展示示例 2 在值为 3 与空节点的比较处失败，因此返回 false。递归是在调用栈中处理这些节点对，迭代则把同样的节点对依次放入队列。",
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>对称二叉树可视化</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:auto;background:#1c1c1c;color:#d4d4d4;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif;font-size:12px;line-height:1.45}\nmain{max-width:560px;margin:0 auto;padding:8px 10px 10px}\nh1{margin:0 0 4px;font-size:14px;font-weight:600;color:#d4d4d4}\n.lead{margin:0 0 8px;color:#8d8d8d;font-size:12px;line-height:1.45}\n.panel{margin-top:8px;padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#252526}\n.panel-title{margin:0 0 6px;font-size:13px;font-weight:600;color:#d4d4d4}\n.rule{padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45}\n.mono{font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.accent{color:#3794ff;font-weight:600}\n.muted{color:#8d8d8d}\n.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n@media(max-width:520px){.grid2{grid-template-columns:1fr}}\n.array,.chars,.row-wrap{display:flex;flex-wrap:wrap;gap:6px}\n.cell,.char,.num-cell{width:38px;min-height:48px;padding:4px 2px;border:1px solid #3c3c3c;border-radius:4px;background:#2d2d30;display:flex;flex-direction:column;align-items:center;justify-content:center;font:600 14px \"SF Mono\",Monaco,Menlo,monospace;transition:.3s}\n.cell .idx,.char .index,.index,.marker{font-size:10px;color:#8d8d8d;margin-top:2px;font-weight:400}\n.cell.active,.cell.mid,.cell.current,.cell.found,.cell.max,.char.active,.num-cell.active{background:#0e639c;border-color:#3794ff;color:#fff}\n.cell.out,.cell.discarded{opacity:.35}\n.card{padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#2d2d30}\n.card-label{font-size:10px;color:#8d8d8d;margin-bottom:4px}\n.card-value{font-size:13px;font-weight:600;font-family:\"SF Mono\",Monaco,Menlo,monospace;color:#3794ff}\n.progress{display:flex;gap:4px;margin-top:8px}\n.dot,.pill{flex:1;height:3px;border-radius:2px;background:#3c3c3c;transition:background .3s}\n.dot.on,.pill.on{background:#3794ff}\n.pills{display:flex;flex-wrap:wrap;gap:4px}\n.pills .pill{flex:none;height:auto;padding:2px 7px;border-radius:4px;font-size:10px;border:1px solid #3c3c3c;color:#8d8d8d}\n.pills .pill.active,.pills .pill.on{background:#0e639c;border-color:#3794ff;color:#fff}\n.status{margin-top:6px;padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45;min-height:auto}\n\n.example{color:#3794ff;font-family:\"SF Mono\",Monaco,Menlo,monospace;font-size:11px}\n.badge{padding:2px 7px;border-radius:4px;border:1px solid #3c3c3c;font-size:10px}\n.badge.true{background:#174c34;border-color:#2f9d65;color:#b5f2cf}\n.badge.false{background:#5a2525;border-color:#d16969;color:#ffd1d1}\n.tree-wrap{overflow-x:auto;margin-top:6px}\nsvg{display:block;width:100%;min-width:320px;height:auto;max-height:200px}\n.edge{stroke:#666;stroke-width:2}\n.mirror-axis{stroke:#3794ff;stroke-width:1.5;stroke-dasharray:5 5;opacity:.75}\n.node circle{fill:#333;stroke:#555;stroke-width:2}\n.node text{fill:#d4d4d4;font-family:\"SF Mono\",Monaco,Menlo,monospace;font-size:12px;text-anchor:middle;dominant-baseline:central}\n.node.active circle{fill:#0e639c;stroke:#3794ff}\n.null-node rect{fill:#2b2b2b;stroke:#666;stroke-width:1.5;stroke-dasharray:4 3;rx:4}\n.null-node text{fill:#8d8d8d;font-size:10px;text-anchor:middle;dominant-baseline:central}\n.compare-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:6px;align-items:center}\n.value-card{padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;text-align:center;background:#2d2d30}\n.value-card.active{background:#0e639c;border-color:#3794ff}\n.value-card.bad{background:#6b2929;border-color:#f14c4c}\n.side{font-size:10px;color:#8d8d8d}\n.value{font-size:14px;font-family:\"SF Mono\",Monaco,Menlo,monospace;color:#fff}\n.operator{font-size:14px;color:#3794ff;font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.explain{margin-top:6px;padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;font-size:12px;line-height:1.45}\n.queue{display:flex;flex-wrap:wrap;gap:4px;min-height:28px}\n.pair{padding:2px 7px;border:1px solid #3c3c3c;border-radius:4px;font-size:10px;font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.pair.current{background:#0e639c;border-color:#3794ff;color:#fff}\n.pair.done{opacity:.45}\n.legend{font-size:10px;color:#8d8d8d;display:flex;flex-wrap:wrap;gap:8px}\n@media(max-width:520px){.compare-grid{grid-template-columns:1fr}.operator{text-align:center}}\n\n.node.mismatch circle,.null-node.mismatch rect{stroke:#f14c4c;fill:#6b2929}\n.tree-wrap svg{max-height:none}.tree-wrap .node text{font-size:20px}.tree-wrap .null-node text{font-size:17px}.tree-wrap svg>text{font-size:17px}.value-card .side{color:#e9f3ff;margin-right:8px}\n</style>\n</head>\n<body>\n<main>\n<h1>沿中轴成对比较</h1>\n<p class=\"example\" id=\"input\" style=\"margin:0 0 6px\"></p>\n<div class=\"row\" style=\"justify-content:space-between\"><span class=\"muted\">镜像 BFS: 出队一对, 再加入子节点对</span><span id=\"result\" class=\"badge\">检查中</span></div>\n<div class=\"tree-wrap\"><svg viewBox=\"0 0 900 390\" role=\"img\" aria-label=\"对称树\"><line class=\"mirror-axis\" x1=\"450\" y1=\"40\" x2=\"450\" y2=\"365\"/><text fill=\"#3794ff\" font-size=\"11\" text-anchor=\"middle\" x=\"450\" y=\"26\">对称轴</text><g id=\"edges\"></g><g id=\"nodes\"></g></svg></div>\n<section class=\"panel\"><div class=\"panel-title\">当前节点对</div>\n<div class=\"compare-grid\">\n<div id=\"leftCard\" class=\"value-card\"><span class=\"side\">左</span><span id=\"leftValue\" class=\"value\">—</span></div>\n<div id=\"operator\" class=\"operator\">↔</div>\n<div id=\"rightCard\" class=\"value-card\"><span class=\"side\">右</span><span id=\"rightValue\" class=\"value\">—</span></div>\n</div>\n<div id=\"explain\" class=\"explain\">准备从根两侧开始比较。</div>\n</section>\n<section class=\"panel\"><div class=\"panel-title\">本次比较后待处理的队列</div><div id=\"queue\" class=\"queue\"></div></section>\n<div class=\"legend panel\">蓝=比较中 · 红=不匹配</div>\n</main>\n<script>\n\nconst layouts = {\n  good: {\n    input: 'root = [1,2,2,3,4,4,3]',\n    nodes: [\n      ['r','1',450,70,'node'], ['l','2',270,155,'node'], ['rr','2',630,155,'node'],\n      ['ll','3',170,265,'node'], ['lr','4',350,265,'node'], ['rl','4',550,265,'node'], ['rrr','3',730,265,'node']\n    ],\n    edges: [['r','l'],['r','rr'],['l','ll'],['l','lr'],['rr','rl'],['rr','rrr']],\n    steps: []\n  },\n  bad: {\n    input: 'root = [1,2,2,null,3,null,3]',\n    nodes: [\n      ['r','1',450,70,'node'], ['l','2',270,155,'node'], ['rr','2',630,155,'node'],\n      ['ll','空',170,265,'null-node'], ['lr','3',350,265,'node'], ['rl','空',550,265,'null-node'], ['rrr','3',730,265,'node']\n    ],\n    edges: [['r','l'],['r','rr'],['l','ll'],['l','lr'],['rr','rl'],['rr','rrr']],\n    steps: []\n  }\n};\n\nfor(const data of Object.values(layouts)){\n const children={r:['l','rr'],l:['ll','lr'],rr:['rl','rrr']};\n const byId=Object.fromEntries(data.nodes.map(n=>[n[0],n]));\n const isNull=id=>id===null||!byId[id]||byId[id][4]==='null-node';\n const value=id=>isNull(id)?'空':byId[id][1];\n const queue=[['l','rr']],frames=[];\n while(queue.length){\n  const [a,b]=queue.shift(),an=isNull(a),bn=isNull(b),bad=an!==bn||(!an&&value(a)!==value(b));\n  if(!bad&&!an){const ac=children[a]||[null,null],bc=children[b]||[null,null];queue.push([ac[0],bc[1]],[ac[1],bc[0]]);}\n  frames.push({a,b,av:value(a),bv:value(b),bad,q:queue.map(p=>[...p]),msg:bad?'一个为空或数值不同, 镜像检查失败, 立即停止.':an?'两个位置均为空, 这一对通过; 不再入队.':'数值相同, 将外侧与内侧镜像对加入队尾.',...(bad?{result:false}:{})});\n  if(bad)break;\n }\n if(!frames.at(-1).bad)frames.push({a:null,b:null,av:'空',bv:'空',q:[],msg:'队列为空, 每对结构和数值均匹配, 返回 true.',result:true});\n data.steps=frames;\n}\n\nconst positions = {};\nconst positionName = id => ({l:'左',rr:'右',ll:'左.左',lr:'左.右',rl:'右.左',rrr:'右.右'}[id] || '空');\nlet mode = 'good';\nlet stepIndex = 0;\n\nfunction drawTree(data) {\n  const nodeLayer = document.getElementById('nodes');\n  const edgeLayer = document.getElementById('edges');\n  nodeLayer.innerHTML = '';\n  edgeLayer.innerHTML = '';\n  Object.keys(positions).forEach(k => delete positions[k]);\n  data.nodes.forEach(([id,label,x,y,type]) => { positions[id] = {x,y}; });\n  data.edges.forEach(([a,b]) => {\n    const p1 = positions[a], p2 = positions[b];\n    edgeLayer.insertAdjacentHTML('beforeend', `<line class=\"edge\" x1=\"${p1.x}\" y1=\"${p1.y+25}\" x2=\"${p2.x}\" y2=\"${p2.y-25}\"/>`);\n  });\n  data.nodes.forEach(([id,label,x,y,type]) => {\n    if (type === 'node') {\n      nodeLayer.insertAdjacentHTML('beforeend', `<g id=\"n-${id}\" class=\"node\"><circle cx=\"${x}\" cy=\"${y}\" r=\"27\"/><text x=\"${x}\" y=\"${y}\">${label}</text></g>`);\n    } else {\n      nodeLayer.insertAdjacentHTML('beforeend', `<g id=\"n-${id}\" class=\"null-node\"><rect x=\"${x-31}\" y=\"${y-21}\" width=\"62\" height=\"42\"/><text x=\"${x}\" y=\"${y}\">${label}</text></g>`);\n    }\n  });\n}\n\nfunction render() {\n  const data = layouts[mode];\n  const step = data.steps[stepIndex];\n  document.getElementById('input').textContent = data.input;\n  document.querySelectorAll('.node, .null-node').forEach(el => el.classList.remove('active','mismatch'));\n  [step.a,step.b].filter(Boolean).forEach(id => {\n    const el = document.getElementById('n-' + id);\n    if (el) el.classList.add(step.bad ? 'mismatch' : 'active');\n  });\n  document.getElementById('leftValue').textContent = step.av;\n  document.getElementById('rightValue').textContent = step.bv;\n  const lc = document.getElementById('leftCard');\n  const rc = document.getElementById('rightCard');\n  lc.className = 'value-card ' + (step.bad ? 'bad' : 'active');\n  rc.className = 'value-card ' + (step.bad ? 'bad' : 'active');\n  document.getElementById('operator').textContent = step.bad ? '≠' : '=';\n  document.getElementById('explain').textContent = step.msg;\n  const result = document.getElementById('result');\n  if (step.result === true) { result.textContent = '结果：true'; result.className = 'badge true'; }\n  else if (step.result === false) { result.textContent = '结果：false'; result.className = 'badge false'; }\n  else { result.textContent = `检查中 · 第 ${stepIndex + 1} 步`; result.className = 'badge'; }\n  const queue = document.getElementById('queue');\n  queue.innerHTML = step.q.length ? step.q.map((p,i) => `<span class=\"pair \">(${positionName(p[0])}, ${positionName(p[1])})</span>`).join('') : '<span class=\"pair done\">队列为空</span>';\n}\n\nfunction next() {\n  const data = layouts[mode];\n  stepIndex++;\n  if (stepIndex >= data.steps.length) {\n    mode = mode === 'good' ? 'bad' : 'good';\n    stepIndex = 0;\n    drawTree(layouts[mode]);\n  }\n  render();\n}\n\ndrawTree(layouts[mode]);\nrender();\nsetInterval(next, 1900);\n\n</script>\n</body>\n</html>",
  "svg": "",
  "media": ""
}
