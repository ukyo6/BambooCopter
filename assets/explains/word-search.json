{
  "kind": "html",
  "caption": "从每个与首字母相同的格子出发, 按右、下、左、上依次尝试相邻格. 进入格子时标记已使用, 失败返回时撤销标记, 一条路径不能重复使用同一格. 动画由真实 DFS 生成, 展示 ABCCED 的成功路径、SEE 从首个 S 失败后换起点成功, 以及 ABCB 尝试全部 A 起点后失败的过程.",
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>单词搜索可视化</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:auto;background:#1c1c1c;color:#d4d4d4;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif;font-size:12px;line-height:1.45}\nmain{max-width:560px;margin:0 auto;padding:8px 10px 10px}\nh1{margin:0 0 4px;font-size:14px;font-weight:600;color:#d4d4d4}\n.lead{margin:0 0 8px;color:#8d8d8d;font-size:12px;line-height:1.45}\n.panel{margin-top:8px;padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#252526}\n.panel-title{margin:0 0 6px;font-size:13px;font-weight:600;color:#d4d4d4}\n.rule{padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45}\n.mono{font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.accent{color:#3794ff;font-weight:600}\n.muted{color:#8d8d8d}\n.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n@media(max-width:520px){.grid2{grid-template-columns:1fr}}\n.array,.chars,.row-wrap{display:flex;flex-wrap:wrap;gap:6px}\n.cell,.char,.num-cell{width:38px;min-height:48px;padding:4px 2px;border:1px solid #3c3c3c;border-radius:4px;background:#2d2d30;display:flex;flex-direction:column;align-items:center;justify-content:center;font:600 14px \"SF Mono\",Monaco,Menlo,monospace;transition:.3s}\n.cell .idx,.char .index,.index,.marker{font-size:10px;color:#8d8d8d;margin-top:2px;font-weight:400}\n.cell.active,.cell.mid,.cell.current,.cell.found,.cell.max,.char.active,.num-cell.active{background:#0e639c;border-color:#3794ff;color:#fff}\n.cell.out,.cell.discarded{opacity:.35}\n.card{padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#2d2d30}\n.card-label{font-size:10px;color:#8d8d8d;margin-bottom:4px}\n.card-value{font-size:13px;font-weight:600;font-family:\"SF Mono\",Monaco,Menlo,monospace;color:#3794ff}\n.progress{display:flex;gap:4px;margin-top:8px}\n.dot,.pill{flex:1;height:3px;border-radius:2px;background:#3c3c3c;transition:background .3s}\n.dot.on,.pill.on{background:#3794ff}\n.pills{display:flex;flex-wrap:wrap;gap:4px}\n.pills .pill{flex:none;height:auto;padding:2px 7px;border-radius:4px;font-size:10px;border:1px solid #3c3c3c;color:#8d8d8d}\n.pills .pill.active,.pills .pill.on{background:#0e639c;border-color:#3794ff;color:#fff}\n.status{margin-top:6px;padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45;min-height:auto}\n\n.layout{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n@media(max-width:520px){.layout{grid-template-columns:1fr}}\n.board{display:grid;grid-template-columns:repeat(4,38px);gap:4px;justify-content:start}\n.board .cell{width:38px;min-height:48px}\n.letter{font-size:14px;font-family:\"SF Mono\",Monaco,Menlo,monospace;font-weight:700}\n.coord{font-size:10px;color:#8d8d8d}\n.cell.current{box-shadow:0 0 0 1px #3794ff}\n.cell.blocked{background:#4a2c2c;border-color:#d16969}\n.word-row{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px}\n.token{min-width:28px;padding:4px 6px;border:1px solid #3c3c3c;border-radius:4px;font-size:12px;font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.token.done,.token.now{background:#0e639c;border-color:#3794ff;color:#fff}\n.rules{display:grid;grid-template-columns:1fr;gap:4px;font-size:11px;line-height:1.45;margin-top:8px}\n.rules .rule{padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#252526}\n.rules b{color:#3794ff;display:block;margin-bottom:2px;font-size:11px}\n.examples{display:grid;grid-template-columns:1fr;gap:4px;font-size:11px;line-height:1.45}\n.yes{color:#89d185}.no{color:#f48771}\n.legend{font-size:10px;color:#8d8d8d;display:flex;gap:6px;flex-wrap:wrap;margin-top:4px}\n.legend .dot{width:10px;height:10px;border:1px solid #3c3c3c;border-radius:3px}\n.legend .dot.used{background:#0e639c;border-color:#3794ff}\n.legend .dot.bad{background:#4a2c2c;border-color:#d16969}\n\n.cell.active .coord,.cell.current .coord{color:#e9f3ff}\n</style>\n</head>\n<body>\n<main>\n<h1>网格 DFS 逐字匹配</h1>\n<p class=\"lead\">四向相邻，路径格子不可复用。</p>\n<section class=\"layout\">\n<div class=\"panel\"><div class=\"panel-title\">board</div><div id=\"board\" class=\"board\"></div>\n<div class=\"legend\"><span><span class=\"dot used\"></span>路径</span><span><span class=\"dot bad\"></span>阻止</span></div></div>\n<div class=\"panel\"><div class=\"panel-title\">匹配 <span id=\"wordName\" class=\"mono\"></span></div><div id=\"wordRow\" class=\"word-row\"></div><div id=\"status\" class=\"status\"></div></div>\n</section>\n<div class=\"rules\"><div class=\"rule\"><b>起点</b>字符等于首字母才启动 DFS</div><div class=\"rule\"><b>扩展</b>四邻匹配下一字符</div><div class=\"rule\"><b>回溯</b>失败撤销占用标记</div></div>\n<section class=\"panel\"><div class=\"panel-title\">样例结论</div><div class=\"examples\">\n<div><span class=\"mono\">ABCCED</span> <span class=\"yes\">true</span></div>\n<div><span class=\"mono\">SEE</span> <span class=\"yes\">true</span></div>\n<div><span class=\"mono\">ABCB</span> <span class=\"no\">false</span>（不能复用 B）</div>\n</div></section>\n</main>\n<script>\n(() => {\n const data=[['A','B','C','E'],['S','F','C','S'],['A','D','E','E']];\n function makeScenario(word){\n  const frames=[],path=[],used=new Set();\n  function snap(text,blocked=null,result=null){frames.push({path:path.map(p=>[...p]),text,blocked,result});}\n  function dfs(r,c,i){\n   const key=r+','+c;used.add(key);path.push([r,c]);snap('匹配第 '+(i+1)+' 个字符 '+word[i]+', 标记 ('+key+') 已使用.');\n   if(i===word.length-1){snap('全部字符匹配: 返回 true. 高亮保留成功路径供观察.',null,true);return true;}\n   for(const [dr,dc] of [[0,1],[1,0],[0,-1],[-1,0]]){\n    const nr=r+dr,nc=c+dc,nk=nr+','+nc;\n    if(nr<0||nr>=data.length||nc<0||nc>=data[0].length)continue;\n    if(data[nr][nc]!==word[i+1])continue;\n    if(used.has(nk)){snap('下一字符需要 '+word[i+1]+', 但 ('+nk+') 已在当前路径中, 禁止复用.',[nr,nc]);continue;}\n    if(dfs(nr,nc,i+1))return true;\n   }\n   path.pop();used.delete(key);snap('从 ('+key+') 回溯: 邻格没有可行后续, 撤销该格占用. 现在路径长 '+path.length+'.');\n   return false;\n  }\n  snap('开始搜索 '+word+', 每个起点使用独立的路径状态.');\n  for(let r=0;r<data.length;r++)for(let c=0;c<data[0].length;c++)if(data[r][c]===word[0]){\n   snap('尝试起点 ('+r+','+c+'), 字符 '+word[0]+'.');if(dfs(r,c,0))return {word,frames};\n  }\n  snap('所有首字母起点均已尝试, 占用标记已全部撤销, 返回 false.',null,false);return {word,frames};\n }\n const scenarios=['ABCCED','SEE','ABCB'].map(makeScenario);\n const boardEl=document.getElementById('board');\n data.forEach((row,r)=>row.forEach((ch,c)=>{const cell=document.createElement('div');cell.className='cell';cell.dataset.key=r+','+c;cell.innerHTML='<span class=\"letter\">'+ch+'</span><span class=\"coord\">('+r+','+c+')</span>';boardEl.appendChild(cell);}));\n let scenarioIndex=0,step=0;\n function render(){const s=scenarios[scenarioIndex],f=s.frames[step];document.getElementById('wordName').textContent=s.word;\n  document.getElementById('wordRow').innerHTML=[...s.word].map((ch,i)=>'<span class=\"token '+(i<f.path.length?(i===f.path.length-1?'now':'done'):'')+'\">'+ch+'</span>').join('');\n  [...boardEl.children].forEach(cell=>{cell.className='cell';const i=f.path.findIndex(p=>p.join(',')===cell.dataset.key);if(i>=0)cell.classList.add(i===f.path.length-1?'current':'active');if(f.blocked&&f.blocked.join(',')===cell.dataset.key)cell.classList.add('blocked');cell.querySelector('.coord').textContent='('+cell.dataset.key+')';});\n  document.getElementById('status').textContent='步骤 '+(step+1)+' / '+s.frames.length+': '+f.text;\n }\n render();setInterval(()=>{step++;if(step>=scenarios[scenarioIndex].frames.length){scenarioIndex=(scenarioIndex+1)%scenarios.length;step=0;}render();},1500);\n})();\n</script>\n</body>\n</html>",
  "svg": "",
  "media": ""
}
