{
  "kind": "html",
  "caption": "用动态规划记录到达每个格子的路径数：第一行和第一列都只有一种走法，其余格子的值等于上方与左方之和。示例 m = 3、n = 7 按斜线逐层填表，最终右下角得到 28；等价地，每条路径包含 2 次向下和 6 次向右，因此共有 C(8, 2) = 28 条。",
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>不同路径可视化</title>\n<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;min-height:auto;background:#1c1c1c;color:#d4d4d4;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",sans-serif;font-size:12px;line-height:1.45}\nmain{max-width:560px;margin:0 auto;padding:8px 10px 10px}\nh1{margin:0 0 4px;font-size:14px;font-weight:600;color:#d4d4d4}\n.lead{margin:0 0 8px;color:#8d8d8d;font-size:12px;line-height:1.45}\n.panel{margin-top:8px;padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#252526}\n.panel-title{margin:0 0 6px;font-size:13px;font-weight:600;color:#d4d4d4}\n.rule{padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45}\n.mono{font-family:\"SF Mono\",Monaco,Menlo,monospace}\n.accent{color:#3794ff;font-weight:600}\n.muted{color:#8d8d8d}\n.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n@media(max-width:520px){.grid2{grid-template-columns:1fr}}\n.array,.chars,.row-wrap{display:flex;flex-wrap:wrap;gap:6px}\n.cell,.char,.num-cell{width:38px;min-height:48px;padding:4px 2px;border:1px solid #3c3c3c;border-radius:4px;background:#2d2d30;display:flex;flex-direction:column;align-items:center;justify-content:center;font:600 14px \"SF Mono\",Monaco,Menlo,monospace;transition:.3s}\n.cell .idx,.char .index,.index,.marker{font-size:10px;color:#8d8d8d;margin-top:2px;font-weight:400}\n.cell.active,.cell.mid,.cell.current,.cell.found,.cell.max,.char.active,.num-cell.active{background:#0e639c;border-color:#3794ff;color:#fff}\n.cell.out,.cell.discarded{opacity:.35}\n.card{padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#2d2d30}\n.card-label{font-size:10px;color:#8d8d8d;margin-bottom:4px}\n.card-value{font-size:13px;font-weight:600;font-family:\"SF Mono\",Monaco,Menlo,monospace;color:#3794ff}\n.progress{display:flex;gap:4px;margin-top:8px}\n.dot,.pill{flex:1;height:3px;border-radius:2px;background:#3c3c3c;transition:background .3s}\n.dot.on,.pill.on{background:#3794ff}\n.pills{display:flex;flex-wrap:wrap;gap:4px}\n.pills .pill{flex:none;height:auto;padding:2px 7px;border-radius:4px;font-size:10px;border:1px solid #3c3c3c;color:#8d8d8d}\n.pills .pill.active,.pills .pill.on{background:#0e639c;border-color:#3794ff;color:#fff}\n.status{margin-top:6px;padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;border-radius:0 4px 4px 0;line-height:1.45;min-height:auto}\n\n.legend{display:flex;flex-wrap:wrap;gap:8px;font-size:10px;color:#8d8d8d;margin-bottom:6px}\n.dot{width:10px;height:10px;border:1px solid #666;border-radius:2px;background:#333;display:inline-block;vertical-align:-1px;margin-right:4px}\n.dot.active{background:#0e639c;border-color:#3794ff}\n.grid-wrap{overflow-x:auto}\n.grid{display:grid;grid-template-columns:repeat(7,38px);gap:4px;min-width:0}\n.grid .cell{width:38px;min-height:48px;padding:4px 2px;font-size:11px}\n.grid .cell .value{font-size:13px;font-weight:700;align-self:center}\n.grid .cell .tag{font-size:10px;color:#8d8d8d}\n.grid .cell.filled .value{color:#d4d4d4}\n.grid .cell.source .value{color:#3794ff}\n.formula{margin-top:4px;color:#fff;font-family:\"SF Mono\",Monaco,Menlo,monospace;font-size:12px}\n.explain{margin-top:6px;padding:8px 10px;border-left:3px solid #3794ff;background:#2d2d30;font-size:12px;line-height:1.45}\n.progress-bar{height:3px;background:#3794ff;border-radius:2px;transition:width .4s}\n.summary{display:grid;grid-template-columns:1fr;gap:4px;margin-top:8px;font-size:11px;line-height:1.45}\n.summary .card{padding:8px 10px;border:1px solid #3c3c3c;border-radius:6px;background:#252526}\n.summary strong{color:#3794ff;display:block;margin-bottom:2px}\n\n.grid{grid-template-columns:repeat(7,48px)}.grid .cell{width:48px}.grid .cell .index{white-space:nowrap}\n</style>\n</head>\n<body>\n<main>\n<h1>不同路径：上方 + 左方</h1>\n<p class=\"lead\">示例 <span class=\"mono\">m = 3, n = 7</span></p>\n<section class=\"panel\"><div class=\"panel-title\">dp[i][j] = 到达格子的路径数</div>\n<div class=\"legend\"><span><i class=\"dot active\"></i>当前</span><span>蓝字=来源格</span></div>\n<div class=\"grid-wrap\"><div id=\"grid\" class=\"grid\"></div></div>\n<div class=\"explain\"><div id=\"stepText\">准备初始化起点。</div><div id=\"formula\" class=\"formula\">dp[0][0] = 1</div></div>\n<div class=\"progress\" style=\"height:3px;background:#3c3c3c;margin-top:6px;border-radius:2px\"><div id=\"progressBar\" class=\"progress-bar\"></div></div>\n</section>\n<div class=\"summary\"><div class=\"card\"><strong>转移</strong><span class=\"mono\">dp[i][j]=上+左</span></div><div class=\"card\"><strong>答案</strong>右下角 28 · O(mn)</div></div>\n</main>\n<script>\n\n(() => {\n  const rows = 3, cols = 7;\n  const dp = Array.from({ length: rows }, () => Array(cols).fill(0));\n  const grid = document.getElementById('grid');\n  const stepText = document.getElementById('stepText');\n  const formula = document.getElementById('formula');\n  const progressBar = document.getElementById('progressBar');\n  const cells = [];\n\n  for (let i = 0; i < rows; i++) {\n    cells[i] = [];\n    for (let j = 0; j < cols; j++) {\n      const cell = document.createElement('div');\n      cell.className = 'cell';\n      const tag = i === 0 && j === 0 ? '起点' : (i === rows - 1 && j === cols - 1 ? '终点' : '');\n      cell.innerHTML = `<div class=\"index\">(${i},${j})</div><div class=\"value\">·</div><div class=\"tag\">${tag}</div>`;\n      grid.appendChild(cell);\n      cells[i][j] = cell;\n    }\n  }\n\n  const frames = [];\n  frames.push({ coords: [[0,0]], text: '起点本身记作 1 条路径。', formula: 'dp[0][0] = 1' });\n  frames.push({ coords: Array.from({length: cols - 1}, (_, k) => [0, k + 1]), text: '第一行只能一路向右，所以每个格子都是 1。', formula: 'dp[0][j] = 1' });\n  frames.push({ coords: Array.from({length: rows - 1}, (_, k) => [k + 1, 0]), text: '第一列只能一路向下，所以每个格子也都是 1。', formula: 'dp[i][0] = 1' });\n  for (let sum = 2; sum <= rows + cols - 2; sum++) {\n    const coords = [];\n    for (let i = 1; i < rows; i++) {\n      const j = sum - i;\n      if (j >= 1 && j < cols) coords.push([i, j]);\n    }\n    if (coords.length) frames.push({ coords, text: '每个格子汇总来自上方和左方的路径。', formula: 'dp[i][j] = 上方 + 左方' });\n  }\n  frames.push({ coords: [[rows-1, cols-1]], text: '右下角得到 28。另一种理解：8 步中选择哪 2 步向下。', formula: 'C(8, 2) = 28' });\n\n  function clearMarks() {\n    cells.flat().forEach(c => c.classList.remove('active', 'source'));\n  }\n\n  function reset() {\n    for (let i = 0; i < rows; i++) for (let j = 0; j < cols; j++) {\n      dp[i][j] = 0;\n      cells[i][j].className = 'cell';\n      cells[i][j].querySelector('.value').textContent = '·';\n    }\n  }\n\n  function fill(i, j) {\n    dp[i][j] = (i === 0 || j === 0) ? 1 : dp[i-1][j] + dp[i][j-1];\n    const cell = cells[i][j];\n    cell.classList.add('filled', 'active');\n    cell.querySelector('.value').textContent = dp[i][j];\n    if (i > 0 && j > 0) {\n      cells[i-1][j].classList.add('source');\n      cells[i][j-1].classList.add('source');\n    }\n  }\n\n  let frame = 0;\n  function play() {\n    if (frame === 0) reset();\n    clearMarks();\n    const current = frames[frame];\n    current.coords.forEach(([i,j]) => fill(i,j));\n    stepText.textContent = `第 ${frame + 1} / ${frames.length} 步：${current.text}`;\n    formula.textContent = current.formula;\n    progressBar.style.width = `${((frame + 1) / frames.length) * 100}%`;\n    frame++;\n    if (frame >= frames.length) {\n      setTimeout(() => { frame = 0; play(); }, 3000);\n    } else {\n      setTimeout(play, 1800);\n    }\n  }\n  play();\n})();\n\n</script>\n</body>\n</html>",
  "svg": "",
  "media": ""
,"time_complexity":"O(mn)","space_complexity":"O(mn)","complexity_note":"m、n 为网格的行数、列数. 演示使用二维 dp 表, 每格计算一次; 若按行滚动且只求路径数, 可降为 O(n) 空间."}
